NODE_ENV=production
PORT=3000
SERVE_WEB=true
WEB_ROOT=/app/public
MONGODB_URI=mongodb+srv://cams_app:replace-me@cluster.example/cams?retryWrites=true&w=majority
MONGODB_DB=cams
REDIS_URL=redis://redis:6379
BACKGROUND_JOBS_ENABLED=false
CORS_ORIGINS=https://cams.example.com
COOKIE_NAME=cams_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=7
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_BASE_URL=https://cams.example.com
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_STALE_SECONDS=10
AUTO_REGISTER_DEVICES=false
MQTT_ENABLED=false
MQTT_URL=mqtts://mqtt.example.com:8883
MQTT_USERNAME=replace-me
MQTT_PASSWORD=replace-me
MQTT_TOPIC=cams/+/+/telemetry
MQTT_STATUS_TOPIC=cams/+/+/status
MQTT_CLIENT_ID=cams-api-production
