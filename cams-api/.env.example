NODE_ENV=development
PORT=3000
SERVE_WEB=false
WEB_ROOT=/app/public
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=cams
CORS_ORIGINS=http://localhost:8080,https://gowtham-protovolt.github.io
COOKIE_NAME=cams_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_HOURS=8
REMEMBER_SESSION_DAYS=7
TELEMETRY_RETENTION_DAYS=7

# Local MQTT defaults. Production must use mqtts:// or wss:// with credentials.
MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1884
MQTT_USERNAME=cams-backend
MQTT_PASSWORD=replace-with-a-long-random-backend-password
MQTT_TOPIC=cams/+/+/telemetry
MQTT_CLIENT_ID=cams-api-local

# Docker Mosquitto device identity. Keep these values only in the untracked .env.
MQTT_DEVICE_USERNAME=cams-esp32-001
MQTT_DEVICE_PASSWORD=replace-with-a-different-long-random-device-password

# Used only by `npm run create-admin`; never commit real values.
CAMS_ADMIN_EMAIL=owner@example.com
CAMS_ADMIN_USERNAME=plant-owner
CAMS_ADMIN_DISPLAY_NAME=Plant Owner
CAMS_ADMIN_PASSWORD=replace-with-a-long-random-password
